{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "index.html",
        "about/index.html",
        "contact/index.html",
        "for-cafes/index.html",
        "blog/index.html",
        "blog/digital-stamp-card-for-cafes-india/index.html",
        "blog/replace-paper-punch-cards/index.html",
        "blog/loyalty-program-ideas-small-shops/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "canonical": "error",
        "is-crawlable": "error",
        "link-name": "error",
        "image-alt": "error",
        "meta-description": "error",
        "html-has-lang": "error",
        "document-title": "error",
        "viewport": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci_report"
    }
  }
}
